NODE_ENV=development
PORT=4000
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://noors:noors@localhost:5432/noors?schema=public
# Integration tests empty every table, so they get their own database (created automatically)
TEST_DATABASE_URL=postgresql://noors:noors@localhost:5432/noors_test?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Razorpay test keys (Dashboard > Account & Settings > API keys). Leave empty in development
# to use the built-in test payment dialog instead. Required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook (Dashboard > Webhooks) pointing at /api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Shiprocket API user (Settings > API > Configure, a separate user from your login). Leave
# empty in development to book made-up shipments instead. Required in production.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Name of your pickup address in Shiprocket, and its pincode (for delivery estimates)
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=190001
# Token you set on the tracking webhook (pointing at /api/v1/webhooks/courier)
SHIPROCKET_WEBHOOK_TOKEN=
# Sends all customer emails. Empty in development: emails are written to the log and sign-in
# codes are shown on the sign-in form. Required in production.
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend
EMAIL_FROM=
# The storefront's public address, for links in emails
STORE_URL=http://localhost:3000
# Gets an email for every new order and for shipments that need a hand
ORDER_ALERT_EMAIL=
CLOUDINARY_URL=
# Encrypts two-factor keys stored in the database. Any long random string; required in
# production, and changing it turns off everyone's two-factor sign-in. e.g. openssl rand -hex 32
APP_SECRET=
