# API settings. Copy to apps/api/.env for development. In production set these as variables on
# the Railway API service (docs/GO_LIVE.md); never commit real values.

# ─── Server ───────────────────────────────────────────────────────────────────
# "production" on Railway (the Docker image sets it); turns on secure cookies and the checks below
NODE_ENV=development
# Port to listen on. Railway sets this itself; leave it unset there
PORT=4000
# Comma-separated list of origins allowed to call the API. Production: the shop's own addresses,
# e.g. https://noors.in,https://www.noors.in
CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API, so rate limits see each shopper's own address. Production
# behind Vercel's /api rewrite and Railway's edge: 2. Local development: 1.
TRUST_PROXY_HOPS=1

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres connection. Matches docker-compose.yml at the repo root; on Railway use
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://noors:noors@localhost:5432/noors?schema=public
# Integration tests empty every table, so they get their own database (created automatically).
# Development only
TEST_DATABASE_URL=postgresql://noors:noors@localhost:5432/noors_test?schema=public
# Local Redis from docker-compose.yml; nothing reads it yet, so leave it out in production
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────────────────────
# Encrypts two-factor keys stored in the database. Any long random string; required in
# production, and changing it turns off everyone's two-factor sign-in. e.g. openssl rand -hex 32
APP_SECRET=

# ─── Payments: Razorpay (required in production) ──────────────────────────────
# API keys (Dashboard > Account & Settings > API keys): rzp_test_... for testing, rzp_live_...
# at launch. Leave empty in development to use the built-in test payment dialog instead
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook (Dashboard > Webhooks) pointing at /api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ─── Shipping: Shiprocket (required in production) ────────────────────────────
# API user (Settings > API > Configure, a separate user from your login). Leave empty in
# development to book made-up shipments instead
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Name of your pickup address in Shiprocket, and its pincode (for delivery estimates)
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=190001
# Token you set on the tracking webhook (pointing at /api/v1/webhooks/courier)
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Email: Resend (required in production) ───────────────────────────────────
# Sends all customer emails. Empty in development: emails are written to the log and sign-in
# codes are shown on the sign-in form
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend, e.g. Noor's <orders@noors.in>
EMAIL_FROM=
# Gets an email for every new order and for shipments that need a hand
ORDER_ALERT_EMAIL=

# ─── Images: Cloudinary (required in production) ──────────────────────────────
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME (Cloudinary dashboard > API Keys). Without it,
# uploads go to UPLOADS_DIR, which only works on your own computer
CLOUDINARY_URL=
# Development only: folder for uploads when Cloudinary isn't set
UPLOADS_DIR=uploads

# ─── Storefront ───────────────────────────────────────────────────────────────
# The shop's public address, for links in emails, e.g. https://noors.in
STORE_URL=http://localhost:3000
# The shop's address for instant catalogue refreshes; usually the same as STORE_URL. With
# REVALIDATE_SECRET, dashboard edits show in the store at once instead of within a minute
WEB_URL=
# Same random string as REVALIDATE_SECRET on the web app (Vercel). e.g. openssl rand -hex 32
REVALIDATE_SECRET=

# ─── Monitoring (optional) ────────────────────────────────────────────────────
# Sentry project DSN; server errors are reported there when set
SENTRY_DSN=
# Log detail: info by default. Uncomment for more
# LOG_LEVEL=debug
