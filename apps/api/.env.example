NODE_ENV=development
PORT=4000
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://noors:noors@localhost:5432/noors?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Filled in during later steps
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
CLOUDINARY_URL=
