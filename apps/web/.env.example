# Web app settings. Copy to apps/web/.env.local for development. In production set these as
# Environment Variables on the Vercel project (docs/GO_LIVE.md); never commit real values.

# ─── API ──────────────────────────────────────────────────────────────────────
# Where the Express API (apps/api) runs. The web app proxies /api and /uploads to it, so the
# browser only ever talks to this app's own origin. Production: https://api.<your domain>.
# Read at build time too, so redeploy after changing it
API_URL=http://localhost:4000

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public address of the store, used for canonical links, the sitemap and social cards.
# Production: https://<your domain>, no trailing slash
SITE_URL=http://localhost:3000

# ─── Catalogue refresh ────────────────────────────────────────────────────────
# Shared secret the API sends to /api/revalidate after dashboard catalogue edits. Must match
# REVALIDATE_SECRET on the API. Leave empty in development (the store refreshes within a minute)
REVALIDATE_SECRET=
